# Sao chép thành .env và điền giá trị. KHÔNG commit file .env.

# ── AI ─────────────────────────────────────────────────────────────
# ollama (chạy local) | gemini (gói free) | deepseek (trả phí, chat qua DeepSeek, embedding qua Gemini)
# | openai (endpoint tương thích OpenAI khác: Groq/OpenAI…)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3

# Gemini — lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# DeepSeek (khi LLM_PROVIDER=deepseek) — lấy key tại https://platform.deepseek.com/api_keys
# Vẫn nên giữ GEMINI_API_KEY để làm embedding cho RAG (DeepSeek không có API embedding)
DEEPSEEK_API_KEY=

# Endpoint tương thích OpenAI (khi LLM_PROVIDER=openai)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# ── Database (lưu lịch sử chat AI) ──────────────────────────────────
# Cách 1: một chuỗi kết nối (Neon/Supabase)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Cách 2: từng biến (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shoe
DB_USER=postgres
DB_PASSWORD=

# ── Kết nối ────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8082/api
CHATBOT_ALLOWED_ORIGINS=http://localhost:3000
